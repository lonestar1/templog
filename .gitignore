# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Captured / intermediate images — regenerated every run
frame.jpg
framing.jpg
preview.jpg
crop.png
testbild.png
_display.png
_mid.png
_proc.png
_proccrop.png

# Run output — data, not code
temps_*.csv
temps_*.html

# Process output
logger.out
stillmon.out
nohup.out

# Runtime state — per-machine, not shared.
# settings.json is whatever was last chosen in the UI on that machine;
# committing it would let a deploy overwrite the Pi's real configuration.
# The defaults in config.py are the source of truth.
run_state.json
settings.json
*.bak

# Secrets (web UI password, etc.)
secrets.json
.env
